# Python build/run artifacts
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
build/
dist/
.venv/
venv/

# latticegen2 run artifacts: intermediate cache folders (spec §4.4, created next to
# the output file as temp/<date><time>/) and generated outputs from ad-hoc local runs.
# Test fixture STEP files under test/ are tracked explicitly and excluded below.
**/temp/
*.log
*.step
!/test/*.step

# Release bundling scratch (tools/build_release.py). The wheels are downloaded
# per build and shipped inside the published assets, not vendored here: the vtk
# Linux wheel alone is 146 MB, over GitHub's hard per-file limit, and binary
# wheels do not delta-compress, so committing them would grow history without
# bound. See docs/release.md.
/wheels/
/.runtime-cache/
